<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <meta
        name="description"
        content="{% block meta_description %}Location de bateaux électriques sans permis à Chanaz avec Entre 2 Rives.{% endblock %}"
    >

    <title>
        {% block title %}Entre 2 Rives{% endblock %}
    </title>

    {# Google Fonts #}
    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
        rel="stylesheet"
    >

    {# Bootstrap CSS #}
    <link
        rel="stylesheet"
        href="{{ asset('css/bootstrap.min.css') }}"
    >

    {# Custom CSS #}
    {% block stylesheets %}

        <link
            rel="stylesheet"
            href="{{ asset('css/app.css') }}"
        >

        <link
            rel="stylesheet"
            href="{{ asset('css/header.css') }}"
        >

        <link
            rel="stylesheet"
            href="{{ asset('css/footer.css') }}"
        >

    {% endblock %}

    {# Favicon #}
    <link
        rel="icon"
        type="image/png"
        href="{{ asset('images/favicon-32x32.png') }}"
    >

</head>

<body>

    {% include 'partials/_header.html.twig' %}

    {# Flash messages #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div
                class="alert alert-{{ type }} flash-message"
                role="alert"
            >
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <main>
        {% block body %}
        {% endblock %}
    </main>

    {% include 'partials/_footer.html.twig' %}

    {% block javascripts %}
        <script src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
        <script src="{{ asset('js/app.js') }}"></script>
    {% endblock %}

</body>
</html>