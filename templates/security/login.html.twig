{% extends 'base.html.twig' %}

{% block title %}
    Connexion | Entre 2 Rives
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link
        rel="stylesheet"
        href="{{ asset('css/security.css') }}"
    >
{% endblock %}

{% block body %}
    <div class="container security">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5">
                <h1 class="security-title">
                    Connexion
                </h1>

                {% if error %}
                    <div class="alert alert-danger flash-message" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form
                    method="post"
                    class="security-form"
                >
                    <div class="security-field">
                        <label
                            for="email"
                            class="form-label"
                        >
                            Adresse e-mail
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            value="{{ last_username }}"
                            class="form-control"
                            autocomplete="email"
                            required
                            autofocus
                        >
                    </div>

                    <div class="security-field">
                        <label
                            for="password"
                            class="form-label"
                        >
                            Mot de passe
                        </label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control"
                            autocomplete="current-password"
                            required
                        >
                    </div>

                    <div class="form-check security-options">
                        <input
                            type="checkbox"
                            id="remember_me"
                            name="_remember_me"
                            class="form-check-input"
                        >

                        <label
                            for="remember_me"
                            class="form-check-label"
                        >
                            Se souvenir de moi
                        </label>
                    </div>

                    <input
                        type="hidden"
                        name="_csrf_token"
                        value="{{ csrf_token('authenticate') }}"
                    >

                    <div class="security-actions">
                        <button
                            type="submit"
                            class="btn btn-primary-custom"
                        >
                            Se connecter
                        </button>
                    </div>
                </form>

                <p class="security-link">
                    Vous n’avez pas encore de compte ?
                    <a href="{{ path('app_register') }}">
                        Créer un compte
                    </a>
                </p>
            </div>
        </div>
    </div>
{% endblock %}