{% extends 'base.html.twig' %}

{% block title %}
    {{ boatModel.name }} - Entre 2 Rives
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link
        rel="stylesheet"
        href="{{ asset('css/boat.css') }}"
    >
{% endblock %}

{% block body %}
    <div class="container boat-detail">
        <a
            href="{{ path('app_boat_index') }}"
            class="boat-detail-back"
        >
            ← Retour aux bateaux
        </a>

        <div class="row g-5">
            <div class="col-12 col-lg-7">
                <div
                    id="boatCarousel"
                    class="carousel slide"
                    role="region"
                    aria-label="Photos du bateau {{ boatModel.name }}"
                >
                    <div class="carousel-indicators">
                        <button
                            type="button"
                            data-bs-target="#boatCarousel"
                            data-bs-slide-to="0"
                            class="active"
                            aria-current="true"
                            aria-label="Afficher la première photo"
                        ></button>

                        <button
                            type="button"
                            data-bs-target="#boatCarousel"
                            data-bs-slide-to="1"
                            aria-label="Afficher la deuxième photo"
                        ></button>

                        <button
                            type="button"
                            data-bs-target="#boatCarousel"
                            data-bs-slide-to="2"
                            aria-label="Afficher la troisième photo"
                        ></button>
                    </div>

                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img
                                src="{{ asset(boatModel.mainImage) }}"
                                class="w-100"
                                alt="Bateau {{ boatModel.name }} - Photo principale vue de côté"
                            >
                        </div>

                        <div class="carousel-item">
                            <img
                                src="{{ asset(boatModel.secondImage) }}"
                                class="w-100"
                                alt="Bateau {{ boatModel.name }} - Photo vue de l'autre côté"
                            >
                        </div>

                        <div class="carousel-item">
                            <img
                                src="{{ asset(boatModel.thirdImage) }}"
                                class="w-100"
                                alt="Bateau {{ boatModel.name }} - Photo vue de l'arrière"
                            >
                        </div>
                    </div>

                    <button
                        class="carousel-control-prev"
                        type="button"
                        data-bs-target="#boatCarousel"
                        data-bs-slide="prev"
                        aria-label="Photo précédente"
                    >
                        <span
                            class="carousel-control-prev-icon"
                            aria-hidden="true"
                        ></span>
                    </button>

                    <button
                        class="carousel-control-next"
                        type="button"
                        data-bs-target="#boatCarousel"
                        data-bs-slide="next"
                        aria-label="Photo suivante"
                    >
                        <span
                            class="carousel-control-next-icon"
                            aria-hidden="true"
                        ></span>
                    </button>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                <h1>
                    {{ boatModel.name }}
                </h1>

                <p class="boat-detail-capacity">
                    Jusqu'à {{ boatModel.capacity }} personnes
                </p>

                <p>
                    {{ boatModel.description }}
                </p>
            </div>
        </div>
    </div>

    <section class="boat-detail-rates">
        <h2 class="boat-detail-rates-title text-center">
            Tarifs
        </h2>

        <div class="boat-detail-rates-list d-flex flex-wrap justify-content-center">
            {% for group in groupedRates %}
                <div class="boat-detail-rate-group text-center">
                    <p>
                        {{ group.duration }}
                        heure{{ group.duration > 1 ? 's' : '' }}
                    </p>

                    {% for rate in group.rates %}
                        <p>
                            {% if rate.label %}
                                {{ rate.label }} —
                            {% endif %}

                            {{ (rate.price / 100)|number_format(0, ',', ' ') }} €
                        </p>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>

        <div class="boat-detail-booking text-center">
            <a
                href="{{ path('app_booking_new', { model: boatModel.slug }) }}"
                class="btn btn-primary-custom btn-lg-custom"
            >
                Réserver maintenant
            </a>
        </div>
    </section>
{% endblock %}