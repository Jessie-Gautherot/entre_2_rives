{% extends 'base.html.twig' %}

{% block title %}Tarifs - Entre 2 Rives{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link
        rel="stylesheet"
        href="{{ asset('css/rate.css') }}"
    >
{% endblock %}

{% block body %}
    <div class="container rate">
        <div class="rate-header">
            <h1>Tarifs</h1>

            <p class="rate-description">
                Selon le modèle de bateau
                et la durée de votre balade.
            </p>
        </div>

        <div class="row g-5">
            {% for item in pricing %}
                <div class="col-12 col-lg-4">
                    <section
                        class="card rate-card"
                        aria-labelledby="rate-title-{{ item.boatModel.id }}"
                    >
                        <div class="card-body">
                            <h2
                                id="rate-title-{{ item.boatModel.id }}"
                                class="card-title"
                            >
                                {{ item.boatModel.name }}
                            </h2>

                            <p class="rate-capacity">
                                Jusqu’à {{ item.boatModel.capacity }} personnes
                            </p>

                            <div class="rate-groups">
                                {% for group in item.rates %}
                                    {% if group.rates|length == 1 %}
                                        <div class="rate-row">
                                            <span class="rate-duration">
                                                {{ group.duration }}
                                                heure{{ group.duration > 1 ? 's' : '' }}
                                            </span>

                                            <span class="rate-price">
                                                {{ (group.rates[0].price / 100)|number_format(0, ',', ' ') }} €
                                            </span>
                                        </div>
                                    {% else %}
                                        <div class="rate-group">
                                            <div class="rate-row">
                                                <span class="rate-duration">
                                                    {{ group.duration }}
                                                    heure{{ group.duration > 1 ? 's' : '' }}
                                                </span>

                                                <span></span>
                                            </div>

                                            {% for rate in group.rates %}
                                                <div class="rate-row">
                                                    <span class="rate-label">
                                                        {{ rate.label }}
                                                    </span>

                                                    <span class="rate-price">
                                                        {{ (rate.price / 100)|number_format(0, ',', ' ') }} €
                                                    </span>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                {% else %}
                                    <p>
                                        Aucun tarif n'est disponible actuellement
                                        pour ce bateau.
                                    </p>
                                {% endfor %}
                            </div>

                            <a
                                class="btn btn-primary-custom"
                                href="{{ path('app_boat_show', {slug: item.boatModel.slug}) }}"
                                aria-label="Voir le bateau {{ item.boatModel.name }}"
                            >
                                Voir ce bateau
                            </a>
                        </div>
                    </section>
                </div>
            {% else %}
                <p class="rate-empty">
                    Aucun tarif n'est disponible actuellement.
                </p>
            {% endfor %}
        </div>
    </div>
{% endblock %}